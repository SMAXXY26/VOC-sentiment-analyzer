{
  "title": "CX Semantic Analyzer Pipeline",
  "uid": "cx-pipeline",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Feedback Queued / sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(producer_feedback_queued_total[1m])",
          "legendFormat": "queued/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Analyses Completed / sec",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(consumer_analyses_completed_total[1m])",
          "legendFormat": "analyzed/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Producer Errors / sec",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(producer_errors_total[1m])",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Analysis Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(consumer_analysis_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(consumer_analysis_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(consumer_analysis_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Worker Slots",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "consumer_active_jobs",
          "legendFormat": "active"
        },
        {
          "expr": "consumer_available_workers",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumer Errors / sec",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "rate(consumer_analyzer_errors_total[1m])",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Producer Publish Latency p95",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(producer_publish_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 publish latency"
        }
      ]
    },
    {
      "id": 8,
      "title": "Total Feedback Queued",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "producer_feedback_queued_total",
          "legendFormat": "total queued"
        }
      ]
    },
    {
      "id": 9,
      "title": "Total Analyses Completed",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "consumer_analyses_completed_total",
          "legendFormat": "total analyzed"
        }
      ]
    },
    {
      "id": 10,
      "title": "Avg Batch Size",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(producer_batch_size_sum[5m]) / rate(producer_batch_size_count[5m])",
          "legendFormat": "avg batch size"
        }
      ]
    },
    {
      "id": 11,
      "title": "Dedup Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "x": 0, "y": 20, "w": 6, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "rate(dedup_cache_hits_total[5m]) / (rate(dedup_cache_hits_total[5m]) + rate(dedup_cache_misses_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 12,
      "title": "Pipeline E2E Latency (computed, p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(pipeline_request_duration_seconds_bucket{outcome=\"computed\"}[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(pipeline_request_duration_seconds_bucket{outcome=\"computed\"}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(pipeline_request_duration_seconds_bucket{outcome=\"computed\"}[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 13,
      "title": "Cache Hit vs Miss / sec",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 20, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "rate(dedup_cache_hits_total[1m])",
          "legendFormat": "hits/s"
        },
        {
          "expr": "rate(dedup_cache_misses_total[1m])",
          "legendFormat": "misses/s"
        }
      ]
    },
    {
      "id": 14,
      "title": "Per-Stage Latency p95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(pipeline_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 20,
      "title": "── Research metrics: inference economics · cascade · calibration ──",
      "type": "text",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 2 },
      "options": { "content": "Token throughput, model-cascade split, the dedup GPU win, confidence calibration, and vLLM-native inference metrics (prefix cache, TTFT)." }
    },
    {
      "id": 21,
      "title": "Generated Tokens / sec (by model tier)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        { "expr": "sum by (model) (rate(llm_completion_tokens_total[1m]))", "legendFormat": "{{model}} completion tok/s" },
        { "expr": "sum by (model) (rate(llm_prompt_tokens_total[1m]))", "legendFormat": "{{model}} prompt tok/s" }
      ]
    },
    {
      "id": 22,
      "title": "Model Cascade Split (calls/sec)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 36, "w": 8, "h": 7 },
      "targets": [
        { "expr": "sum by (model) (rate(llm_calls_total[5m]))", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 23,
      "title": "LLM Calls Avoided by Dedup (cumulative)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 36, "w": 8, "h": 7 },
      "targets": [
        { "expr": "llm_calls_saved_total", "legendFormat": "calls saved" }
      ]
    },
    {
      "id": 24,
      "title": "Pipeline Confidence (p10 / p50 / p90)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 43, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        { "expr": "histogram_quantile(0.10, rate(pipeline_confidence_bucket[5m]))", "legendFormat": "p10" },
        { "expr": "histogram_quantile(0.50, rate(pipeline_confidence_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, rate(pipeline_confidence_bucket[5m]))", "legendFormat": "p90" }
      ]
    },
    {
      "id": 25,
      "title": "Needs-Review Rate (active learning)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 43, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "rate(needs_review_total[5m]) / clamp_min(rate(dedup_cache_misses_total[5m]), 0.0001)", "legendFormat": "flagged fraction" }
      ]
    },
    {
      "id": 26,
      "title": "vLLM: prefix-cache hit rate · TTFT p95",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 43, "w": 8, "h": 7 },
      "targets": [
        { "expr": "vllm:gpu_prefix_cache_hit_rate", "legendFormat": "prefix cache hit rate" },
        { "expr": "histogram_quantile(0.95, rate(vllm:time_to_first_token_seconds_bucket[5m]))", "legendFormat": "TTFT p95 (s)" }
      ]
    }
  ]
}
