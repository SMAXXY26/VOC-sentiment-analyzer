# Secrets / git
.env
.git

# Python caches
__pycache__
**/__pycache__
*.pyc
*.pyo
*.egg-info

# Node / Next.js (patterns are not recursive — match nested copies explicitly)
node_modules
**/node_modules
.next
**/.next

# Rust build artifacts
target
**/target

# Hugging Face model cache (multi-GB downloaded models — never needed in a build)
.hf_cache
**/.hf_cache

# Training outputs (checkpoints, merged/quantized models)
training/checkpoints
training/merged
training/quantized

# Chatbot EDBMS — must be seeded fresh inside the container, never baked from a
# local copy (a stale db would skip _seed() and ship outdated demo data).
**/edbms.db

# Misc local artifacts
build.log
Miniforge3*.sh
results*.json
*.log
.pytest_cache
**/.pytest_cache
.venv
venv
